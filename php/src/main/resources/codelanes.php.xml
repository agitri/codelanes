<!-- Content module: loaded only when the PHP plugin is there (PhpStorm, or IntelliJ IDEA with PHP). -->
<idea-plugin package="dev.codelanes.php">
    <dependencies>
        <plugin id="com.jetbrains.php"/>
    </dependencies>
    <extensions defaultExtensionNs="dev.codelanes">
        <languageSupport implementation="dev.codelanes.php.PhpLanguageSupport"/>
    </extensions>
</idea-plugin>
