<idea-plugin>
    <id>dev.codelanes</id>
    <name>CodeLanes</name>
    <vendor url="https://github.com/agitri/codelanes">Rene Gerrits</vendor>
    <description><![CDATA[
        <p><b>Read code like a human.</b> CodeLanes replaces the vertical, line-by-line editor for PHP and Java classes with a
        canvas of real, editable code blocks laid out in lanes: what a class builds on on the left, the class in the
        middle, its methods on the right, connected by colour-coded, labelled lines.</p>
        <p>Made for really understanding code, especially code an AI wrote: no AI, no summaries, just the real code
        with its structure on screen.</p>
        <ul>
          <li><b>The canvas is the editor</b>: every block is a real IDE editor (completion, inspections,
              refactorings, undo). The file on disk stays plain PHP or Java.</li>
          <li><b>Follow a Request</b>: pick a route (PHP <code>#[Route]</code> or <code>config/routes</code> YAML/XML,
              Spring <code>@GetMapping</code>, <code>@PostMapping</code>, <code>@RequestMapping</code>, …) and see the whole
              chain of code it runs, through interfaces into their implementations.</li>
          <li><b>+ calls</b>, <b>Add method…</b> and <b>+ parents</b>: follow the flow across files.</li>
          <li><b>Review marks and notes</b> shared with your team in <code>.codelanes/</code>, and
              <b>working sets</b> to save and reopen the canvases of a review.</li>
          <li><b>Java and Spring</b> in IntelliJ IDEA: injected beans (also through Lombok), overloads, and AI flows that
              prove Spring's bindings, events and listeners.</li>
          <li>Lanes, Column and Tree layouts; usage highlighting; Cmd+click stays on the canvas.</li>
        </ul>
        <p>Works in PhpStorm (PHP) and IntelliJ IDEA (Java); other JetBrains IDEs aren't supported yet.</p>
        <p>Toggle between blocks and text with <b>Ctrl+Alt+Shift+B</b>. Source and issues:
        <a href="https://github.com/agitri/codelanes">github.com/agitri/codelanes</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="codelanes-mcp.xml">com.intellij.mcpServer</depends>

    <!-- Language support lives in content modules with their own jars (lib/modules/), each loaded only when its language plugin is there. -->
    <content>
        <module name="codelanes.php"/>
        <module name="codelanes.java"/>
        <module name="codelanes.python"/>
    </content>

    <extensionPoints>
        <extensionPoint qualifiedName="dev.codelanes.languageSupport" interface="dev.codelanes.lang.LanguageSupport" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="dev.codelanes.ide.BlocksEditorProvider"/>
        <notificationGroup id="CodeLanes" displayType="BALLOON"/>
        <editorNotificationProvider implementation="dev.codelanes.ide.BlocksUnavailableNotification"/>
        <editorActionHandler action="EditorBackSpace" implementationClass="dev.codelanes.editor.SliceBackspaceGuard" order="first"/>
        <editorActionHandler action="EditorUp" implementationClass="dev.codelanes.editor.SliceUpNavigation" order="first"/>
        <editorActionHandler action="EditorDown" implementationClass="dev.codelanes.editor.SliceDownNavigation" order="first"/>
        <editorActionHandler action="EditorDelete" implementationClass="dev.codelanes.editor.SliceDeleteGuard" order="first"/>
    </extensions>

    <actions>
        <action id="CodeLanes.ToggleBlocksView"
                class="dev.codelanes.ide.ToggleBlocksViewAction"
                text="Toggle Blocks / Text View">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift B"/>
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
        <action id="CodeLanes.ResetBlocksLayout"
                class="dev.codelanes.ide.ResetBlocksLayoutAction"
                text="Reset Blocks Layout">
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
        <action id="CodeLanes.BlocksByDefault"
                class="dev.codelanes.ide.BlocksByDefaultAction"
                text="Open Files as Blocks by Default">
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
        <action id="CodeLanes.VerticalLayout" class="dev.codelanes.ide.VerticalLayoutAction" text="Vertical Layout (experiment)"
                description="Put every block in one column, top to bottom">
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
        <action id="CodeLanes.TreeLayout" class="dev.codelanes.ide.TreeLayoutAction" text="Tree Layout (experiment)"
                description="Each level a row, lines from the bottom of a block into the top of the next">
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
        <action id="CodeLanes.AddMethodToCanvas" class="dev.codelanes.ide.AddMethodToCanvasAction" text="Add Method to Canvas…"
                description="Find any method in the project and drop it on the open canvas">
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
        <action id="CodeLanes.FollowRequest" class="dev.codelanes.ide.FollowRequestAction" text="Follow a Request…"
                description="Pick a route and see the whole chain of code it runs on one canvas">
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </action>
        <group id="CodeLanes.WorkingSets" text="CodeLanes Working Sets" popup="true">
            <action id="CodeLanes.SaveWorkingSet" class="dev.codelanes.ide.SaveWorkingSetAction" text="Save Working Set…"/>
            <action id="CodeLanes.OpenWorkingSet" class="dev.codelanes.ide.OpenWorkingSetAction" text="Open Working Set…"/>
            <action id="CodeLanes.DeleteWorkingSet" class="dev.codelanes.ide.DeleteWorkingSetAction" text="Delete Working Set…"/>
            <add-to-group group-id="ViewMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
